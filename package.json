{
  "name": "yac-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YAC CRM: accounts, contacts, leads, opportunities, cases, reports and setup. Local only.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/dev.js",
    "server": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "reset-db": "node --no-warnings=ExperimentalWarning scripts/reset-db.js",
    "test": "node --no-warnings=ExperimentalWarning --test --test-concurrency=1 'test/*.test.js'",
    "e2e": "playwright test",
    "lint": "eslint web/src server shared"
  },
  "dependencies": {
    "@kasumi/ui": "file:../kasumi",
    "express": "^5.2.1",
    "lucide-react": "^0.545.0",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^8.1.4"
  }
}
